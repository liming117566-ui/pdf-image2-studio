# Required application settings
APP_PASSWORD=change-me-in-your-local-env
APP_ORIGIN=http://localhost:3000

# Image2-compatible API
API_BASE_URL=https://your-image-api.example/v1
API_MODEL=gpt-image-2
API_KEY=replace-with-your-api-key

# Optional limits and runtime settings
MAX_UPLOAD_MB=120
GENERATION_CONCURRENCY=2
RETENTION_DAYS=7
UPSTREAM_TIMEOUT_MS=300000
